<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Avtomagazin.MauiShared.CoveragePage"
             Title="Визиты"
             BackgroundColor="#12241C">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Подписки жителей" TextColor="#F3F7F3" FontAttributes="Bold" FontSize="18" />
            <Label Text="Сколько человек держат остановку в избранном — там есть кому слать пуш." TextColor="#A7B8AD" FontSize="13" />
            <StackLayout x:Name="Subs" Spacing="6" />
            <Label Text="Визиты автолавок" TextColor="#F3F7F3" FontAttributes="Bold" FontSize="18" Margin="0,12,0,0" />
            <StackLayout x:Name="Visits" Spacing="6" />
            <Button Text="Выйти" Clicked="OnRole" BackgroundColor="#1B3328" TextColor="#F3F7F3" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
