<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Avtomagazin.MauiShared.ResidentSchedulePage"
             Title="Рейс"
             BackgroundColor="#12241C">
    <CollectionView x:Name="List" Margin="16" SelectionMode="Single" SelectionChanged="OnSelect">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid Padding="0,10" ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="{Binding SettlementName}" TextColor="#F3F7F3" FontAttributes="Bold" />
                        <Label Text="{Binding Subtitle}" TextColor="#A7B8AD" FontSize="13" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="{Binding Time}" TextColor="#A7B8AD" VerticalOptions="Center" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
