<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.Maui"
             x:Class="Avtomagazin.MauiShared.DrivePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#12241C">
    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        <Border x:Name="LinkBanner"
                Grid.Row="0"
                IsVisible="False"
                Margin="16,44,16,0"
                Padding="12,10"
                StrokeThickness="0"
                BackgroundColor="#3A2A1C"
                StrokeShape="RoundRectangle 10">
            <Label x:Name="LinkBannerText"
                   TextColor="#F0C7B0"
                   FontSize="13"
                   LineBreakMode="WordWrap" />
        </Border>

        <ScrollView Grid.Row="1" x:Name="RoutePanel">
            <VerticalStackLayout Padding="16,12,16,24" Spacing="14">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="VanLabel" FontSize="20" FontAttributes="Bold" TextColor="#F3F7F3" />
                    <Label x:Name="RouteLabel" TextColor="#A7B8AD" FontSize="14" />
                </VerticalStackLayout>

                <Border x:Name="NextCard" Stroke="#2A4638" StrokeThickness="1" BackgroundColor="#1B3328" Padding="16" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Следующая" TextColor="#6B7F74" FontSize="12" />
                        <Label x:Name="NextTitle" FontSize="24" FontAttributes="Bold" TextColor="#F3F7F3" />
                        <Label x:Name="NextMeta" TextColor="#A7B8AD" FontSize="18" FontAttributes="Bold" />
                        <Label x:Name="NextDistance" TextColor="#A7B8AD" FontSize="14" IsVisible="False" />
                        <mapsui:MapControl x:Name="NextMap"
                                          HeightRequest="180"
                                          IsVisible="False"
                                          BackgroundColor="#0E1C16" />
                        <HorizontalStackLayout x:Name="MapLegend"
                                              IsVisible="False"
                                              Spacing="14"
                                              HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView WidthRequest="10" HeightRequest="10" Color="#3DBA7A" CornerRadius="1" VerticalOptions="Center" />
                                <Label Text="Вы" TextColor="#A7B8AD" FontSize="12" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <BoxView WidthRequest="10" HeightRequest="10" Color="#F3F7F3" CornerRadius="5" VerticalOptions="Center" />
                                <Label Text="Остановка" TextColor="#A7B8AD" FontSize="12" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                        <Grid x:Name="NextActions" ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="False">
                            <Button x:Name="ArriveBtn"
                                    Text="На месте"
                                    Clicked="OnArriveNext"
                                    BackgroundColor="#3DBA7A"
                                    TextColor="#082014"
                                    HeightRequest="48"
                                    CornerRadius="12" />
                            <Button Grid.Column="1"
                                    Text="Пропустить"
                                    Clicked="OnSkipNext"
                                    BackgroundColor="#1B3328"
                                    TextColor="#F3F7F3"
                                    HeightRequest="48"
                                    CornerRadius="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Остановки сегодня" TextColor="#A7B8AD" FontSize="13" />
                <VerticalStackLayout x:Name="Stops" Spacing="8" />
                <Label x:Name="RouteStatus" TextColor="#F0C7B0" FontSize="13" />
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView Grid.Row="1" x:Name="GpsPanel" IsVisible="False">
            <VerticalStackLayout Padding="16,12,16,24" Spacing="14">
                <Label Text="Трекер" FontSize="20" FontAttributes="Bold" TextColor="#F3F7F3" />
                <Label Text="Диспетчер видит вашу точку на карте, пока трекер включён." TextColor="#A7B8AD" FontSize="14" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label x:Name="GpsStatus"
                           TextColor="#A7B8AD"
                           FontSize="15"
                           VerticalOptions="Center" />
                    <Switch x:Name="TrackerSwitch"
                            Grid.Column="1"
                            OnColor="#3DBA7A"
                            ThumbColor="#F3F7F3"
                            VerticalOptions="Center"
                            Toggled="OnTrackerToggled" />
                </Grid>

                <BoxView HeightRequest="1" Color="#2A4638" Margin="0,8" />
                <Label Text="Сообщение диспетчеру" FontSize="18" FontAttributes="Bold" TextColor="#F3F7F3" />
                <Label Text="Уйдёт с вашей координатой — увидит диспетчер." TextColor="#A7B8AD" FontSize="13" />
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="NoteChipStuck" Text="Завяз" Clicked="OnNoteStuck" BackgroundColor="#1B3328" TextColor="#F3F7F3" HeightRequest="40" CornerRadius="10" Padding="12,0" />
                    <Button x:Name="NoteChipTire" Text="Пробил колесо" Clicked="OnNoteTire" BackgroundColor="#1B3328" TextColor="#F3F7F3" HeightRequest="40" CornerRadius="10" Padding="12,0" />
                    <Button x:Name="NoteChipWait" Text="Стою" Clicked="OnNoteWait" BackgroundColor="#1B3328" TextColor="#F3F7F3" HeightRequest="40" CornerRadius="10" Padding="12,0" />
                </HorizontalStackLayout>
                <Entry x:Name="NoteEntry"
                       Placeholder="Свой комментарий…"
                       PlaceholderColor="#6B7F74"
                       TextColor="#F3F7F3"
                       BackgroundColor="#1B3328"
                       HeightRequest="48" />
                <Button x:Name="NoteActionBtn"
                        Text="Отправить"
                        Clicked="OnNoteAction"
                        BackgroundColor="#3DBA7A"
                        TextColor="#082014"
                        HeightRequest="48"
                        CornerRadius="12" />
                <Label x:Name="NoteStatus" TextColor="#A7B8AD" FontSize="13" />

                <Button Text="Выйти" Clicked="OnRole" BackgroundColor="Transparent" TextColor="#A7B8AD" HeightRequest="44" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              Padding="12,8,12,12"
              ColumnSpacing="8"
              BackgroundColor="#0E1C16">
            <Button x:Name="TabRoute" Text="Рейс" Clicked="OnTabRoute" HeightRequest="48" CornerRadius="12" />
            <Button x:Name="TabGps" Grid.Column="1" Text="GPS" Clicked="OnTabGps" HeightRequest="48" CornerRadius="12" />
        </Grid>
    </Grid>
</ContentPage>
