<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Avtomagazin.MauiShared.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#12241C">
    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="10" MaximumWidthRequest="420">
            <Label x:Name="EnvLabel" TextColor="#6B7F74" FontSize="12" />
            <Label x:Name="TitleLabel" FontSize="32" FontAttributes="Bold" TextColor="#F3F7F3" />
            <Label x:Name="SubtitleLabel" TextColor="#A7B8AD" Margin="0,0,0,12" />

            <Label Text="Email" TextColor="#A7B8AD" />
            <Entry x:Name="EmailEntry"
                   Keyboard="Email"
                   Placeholder="email"
                   PlaceholderColor="#6B7F74"
                   TextColor="#F3F7F3"
                   BackgroundColor="#1B3328"
                   HeightRequest="48" />

            <Label Text="Пароль" TextColor="#A7B8AD" />
            <Entry x:Name="PasswordEntry"
                   IsPassword="True"
                   Placeholder="пароль"
                   PlaceholderColor="#6B7F74"
                   TextColor="#F3F7F3"
                   BackgroundColor="#1B3328"
                   HeightRequest="48" />

            <VerticalStackLayout x:Name="NameBlock" IsVisible="False" Spacing="10">
                <Label Text="Имя" TextColor="#A7B8AD" />
                <Entry x:Name="NameEntry"
                       Placeholder="как к вам обращаться"
                       PlaceholderColor="#6B7F74"
                       TextColor="#F3F7F3"
                       BackgroundColor="#1B3328"
                       HeightRequest="48" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="StaffRoleBlock" IsVisible="False" Spacing="8" Margin="0,4,0,4">
                <Label Text="Кто вы" TextColor="#A7B8AD" />
                <Button x:Name="DriverRoleButton" Text="Водитель — веду автолавку" Clicked="OnPickDriver" BackgroundColor="#1B3328" TextColor="#F3F7F3" HeightRequest="48" />
                <Button x:Name="SellerRoleButton" Text="Продавец — торгую в салоне" Clicked="OnPickSeller" BackgroundColor="#1B3328" TextColor="#F3F7F3" HeightRequest="48" />
                <Button x:Name="DispatcherRoleButton" Text="Диспетчер — сижу в офисе" Clicked="OnPickDispatcher" BackgroundColor="#1B3328" TextColor="#F3F7F3" HeightRequest="48" />
            </VerticalStackLayout>
            <Button Text="Войти"
                    Clicked="OnLogin"
                    BackgroundColor="#3DBA7A"
                    TextColor="#082014"
                    HeightRequest="48"
                    Margin="0,8,0,0" />
            <Button x:Name="RegisterButton"
                    Text="Зарегистрироваться"
                    Clicked="OnRegister"
                    IsVisible="False"
                    BackgroundColor="#1B3328"
                    TextColor="#F3F7F3"
                    HeightRequest="48" />

            <Label x:Name="ErrorLabel" TextColor="#F0C7B0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
