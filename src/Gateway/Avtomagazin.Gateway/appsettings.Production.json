{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      },
      "fleet": {
        "ClusterId": "fleet",
        "Match": { "Path": "/fleet/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      },
      "routing": {
        "ClusterId": "routing",
        "Match": { "Path": "/routing/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": { "Path": "/notifications/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://identity:8080/" }
        }
      },
      "fleet": {
        "Destinations": {
          "d1": { "Address": "http://fleet:8080/" }
        }
      },
      "routing": {
        "Destinations": {
          "d1": { "Address": "http://routing:8080/" }
        }
      },
      "notifications": {
        "Destinations": {
          "d1": { "Address": "http://notifications:8080/" }
        }
      }
    }
  }
}
