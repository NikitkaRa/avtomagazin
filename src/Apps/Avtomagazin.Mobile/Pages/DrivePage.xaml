<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.Maui"
             x:Class="Avtomagazin.Mobile.DrivePage"
             Title="Рейс"
             BackgroundColor="#12241C">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label x:Name="VanLabel" FontSize="22" FontAttributes="Bold" TextColor="#F3F7F3" />
            <Label x:Name="NextLabel" TextColor="#A7B8AD" />
            <mapsui:MapControl x:Name="MapView" HeightRequest="240" />
            <StackLayout x:Name="Stops" Spacing="6" />
            <Label x:Name="Status" TextColor="#3DBA7A" />
            <Button Text="Транслировать GPS" Clicked="OnLive" BackgroundColor="#3DBA7A" TextColor="#082014" />
            <Button Text="Демо-маршрут" Clicked="OnDemo" BackgroundColor="#1B3328" TextColor="#F3F7F3" />
            <Button Text="Стоп" Clicked="OnStop" BackgroundColor="#1B3328" TextColor="#F3F7F3" />
            <Button Text="Сменить роль" Clicked="OnRole" BackgroundColor="#12241C" TextColor="#A7B8AD" />
            <Label Text="GPS с телефона шлёт точку на API. «На месте» — пуш избранным, с GPS сам не уходит." TextColor="#A7B8AD" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
