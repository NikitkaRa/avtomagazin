{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "BaseUrl": "http://127.0.0.1:5100"
  },
  "Maps": {
    "YandexApiKey": ""
  },
  "ReverseProxy": {
    "Routes": {
      "fleet": {
        "ClusterId": "gateway",
        "Match": { "Path": "/fleet/{**catch-all}" }
      },
      "routing": {
        "ClusterId": "gateway",
        "Match": { "Path": "/routing/{**catch-all}" }
      },
      "notifications": {
        "ClusterId": "gateway",
        "Match": { "Path": "/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "gateway": {
        "Destinations": {
          "d1": { "Address": "http://127.0.0.1:5100/" }
        }
      }
    }
  }
}
