@inject AvtomagazinClient Api
@inject StaffSession Session

<div class="auth-gate">
    <div class="auth-bg" aria-hidden="true"></div>
    <div class="auth-veil" aria-hidden="true"></div>
    <div class="auth-glow" aria-hidden="true"></div>

    <section class="auth-panel">
        <p class="auth-brand">Автолавка</p>
        <h1 class="auth-title">Вход в панель управления</h1>

        <form class="auth-form" @onsubmit="EnterAsync" @onsubmit:preventDefault>
            <label class="auth-field">
                <span>Email</span>
                <input type="email" @bind="_email" autocomplete="username" autofocus />
            </label>
            <label class="auth-field">
                <span>Пароль</span>
                <div class="auth-password">
                    <input type="@(_showPassword ? "text" : "password")"
                           @bind="_password"
                           autocomplete="current-password" />
                    <button type="button"
                            class="auth-eye"
                            aria-label="@(_showPassword ? "Скрыть пароль" : "Показать пароль")"
                            @onclick="() => _showPassword = !_showPassword">
                        @(_showPassword ? "скрыть" : "показать")
                    </button>
                </div>
            </label>

            <label class="auth-remember">
                <input type="checkbox" @bind="_remember" />
                <span>Запомнить меня</span>
            </label>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert" role="alert">@_error</div>
            }

            <button type="submit" class="btn auth-submit" disabled="@_busy">
                @(_busy ? "…" : "Войти")
            </button>
        </form>
    </section>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _busy;
    private bool _remember = true;
    private bool _showPassword;

    private async Task EnterAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var login = await Api.LoginAsync(_email.Trim(), _password);
            if (login is null)
            {
                _error = "Неверный email или пароль.";
                return;
            }

            if (login.Role is not ("driver" or "seller" or "operator" or "admin"))
            {
                _error = "Этот аккаунт для жителей. Откройте приложение жителя.";
                return;
            }

            Session.SignIn(login.Role, login.Email, login.Name, login.VehicleId, login.AccessToken, _remember);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
