@inject AvtomagazinClient Api
@inject StaffSession Session

<div class="auth-gate">
    <div class="auth-bg" aria-hidden="true"></div>
    <div class="auth-veil" aria-hidden="true"></div>

    <section class="auth-panel">
        <p class="auth-brand">Автомагазин</p>
        <h1 class="auth-title">Вход в панель</h1>
        <p class="auth-lead">Персонал райпо. Жителям — приложение жителя.</p>

        <form class="auth-form" @onsubmit="EnterAsync" @onsubmit:preventDefault>
            <label class="auth-field">
                <span>Email</span>
                <input type="email" @bind="_email" autocomplete="username" autofocus />
            </label>
            <label class="auth-field">
                <span>Пароль</span>
                <input type="password" @bind="_password" autocomplete="current-password" />
            </label>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert" role="alert">@_error</div>
            }

            <button type="submit" class="btn auth-submit" disabled="@_busy">
                @(_busy ? "…" : "Войти")
            </button>
        </form>
    </section>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    private async Task EnterAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var login = await Api.LoginAsync(_email.Trim(), _password);
            if (login is null)
            {
                _error = "Неверный email или пароль.";
                return;
            }

            if (login.Role is not ("driver" or "operator" or "admin"))
            {
                _error = "Этот аккаунт для жителей. Откройте приложение жителя.";
                return;
            }

            Session.SignIn(login.Role, login.Email, login.Name, login.VehicleId, login.AccessToken);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
