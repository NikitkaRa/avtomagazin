@page "/eta"
@inject AvtomagazinClient Api

<PageTitle>ETA</PageTitle>

<h1>Прогнозы прибытия</h1>

<div class="form-grid">
    <input @bind="_settlement" placeholder="Фильтр по деревне" />
    <button class="btn" @onclick="ReloadAsync">Обновить</button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert">@_error</div>
}
else if (_loading)
{
    <p>Загрузка…</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Пункт</th>
            <th>Минут</th>
            <th>ETA UTC</th>
            <th>Посчитано</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var e in _etas.OrderBy(x => x.EstimatedArrivalUtc))
        {
            <tr>
                <td>@e.SettlementName</td>
                <td>@e.MinutesUntilArrival</td>
                <td>@e.EstimatedArrivalUtc.ToString("HH:mm:ss")</td>
                <td>@e.CalculatedAtUtc.ToString("HH:mm:ss")</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private bool _loading = true;
    private string? _error;
    private string _settlement = "";
    private List<EtaDto> _etas = [];

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _etas = await Api.GetEtaAsync(string.IsNullOrWhiteSpace(_settlement) ? null : _settlement);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
