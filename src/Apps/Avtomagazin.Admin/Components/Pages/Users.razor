@page "/users"
@inject AvtomagazinClient Api

<PageTitle>Люди</PageTitle>

<StaffPageGate RequireAdmin="true" OnReady="ReloadAsync">
<div class="page-head">
    <div>
        <div class="brand">Люди</div>
        <div class="who">Персонал — заявки и назначения. Жители — отдельно, их много.</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert">@_error</div>
}

<div class="filter-chips users-segment" role="tablist" aria-label="Раздел">
    <button type="button" class="chip @SegmentOn("staff")" @onclick='() => SetSegment("staff")'>Персонал</button>
    <button type="button" class="chip @SegmentOn("residents")" @onclick='() => SetSegment("residents")'>Жители</button>
</div>

@if (_segment == "staff")
{
    <UsersPending Pending="_pending"
                  Vans="_vans"
                  VanOf="VanOf"
                  VanChanged="args => SetVan(args.Id, args.Value)"
                  Approve="ApproveAsync"
                  Reject="RejectAsync" />
}

<UsersDirectory Segment="@_segment"
                Filtered="Filtered"
                ResetId="_resetId"
                ResetPassword="@_resetPassword"
                ResetPasswordChanged="v => _resetPassword = v"
                RoleOn="RoleOn"
                StatusOn="StatusOn"
                AssignOn="AssignOn"
                SetRole="SetRole"
                SetStatus="SetStatus"
                SetAssign="SetAssign"
                VanLabel="VanLabel"
                Disable="DisableAsync"
                Approve="ApproveAsync"
                ToggleReset="ToggleReset"
                ResetPasswordSubmit="ResetPasswordAsync" />

@if (_segment == "residents" && _residentTotal > ResidentPageSize)
{
    <div class="row" style="margin-top:0.75rem">
        <button type="button" class="btn btn-ghost" disabled="@(_residentSkip == 0)" @onclick="PrevResidentsAsync">Назад</button>
        <span class="muted tiny">@_residentSkip–@Math.Min(_residentSkip + ResidentPageSize, _residentTotal) из @_residentTotal</span>
        <button type="button" class="btn btn-ghost" disabled="@(_residentSkip + ResidentPageSize >= _residentTotal)" @onclick="NextResidentsAsync">Ещё</button>
    </div>
}
</StaffPageGate>
