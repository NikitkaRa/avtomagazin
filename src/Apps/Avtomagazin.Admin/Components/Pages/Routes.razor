@page "/routes"
@inject AvtomagazinClient Api
@inject StaffSession Session
@inject UiToasts Toasts

<PageTitle>Маршруты</PageTitle>

<StaffPageGate OnReady="ReloadAsync">
<div class="page-head">
    <div>
        <div class="brand">Маршруты</div>
        <div class="who">Краткий список. Создание и правки — на отдельных экранах.</div>
    </div>
    <a class="btn" href="routes/new">Новый маршрут</a>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert">@_error</div>
}

@if (_loading)
{
    <p class="muted">Загрузка…</p>
}
else if (_routes.Count == 0)
{
    <p class="empty">Маршрутов пока нет. Создайте первый.</p>
}
else
{
    <ul class="feed">
        @foreach (var route in _routes)
        {
            var stops = (route.Stops ?? []).OrderBy(s => s.Sequence).ToList();
            <li class="feed-row">
                <div>
                    <strong>@route.Name</strong>
                    <span class="feed-sub">
                        @PlateFor(route.VehicleId) · @stops.Count ост.
                        @if (stops.Count > 0)
                        {
                            <text> · @stops.First().SettlementName</text>
                            @if (stops.Count > 1)
                            {
                                <text> → @stops.Last().SettlementName</text>
                            }
                        }
                    </span>
                </div>
                    <div class="feed-side">
                        <a class="btn btn-ghost" href="@($"routes/{route.Id}")">Открыть</a>
                        <button type="button" class="btn btn-ghost" disabled="@_busy" @onclick="() => DeleteAsync(route)">Удалить</button>
                    </div>
            </li>
        }
    </ul>
}
</StaffPageGate>

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private List<RouteDto> _routes = [];
    private List<VehicleDto> _vehicles = [];

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _vehicles = await Api.GetVehiclesAsync();
            _routes = await Api.GetRoutesAsync(catalog: true);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteAsync(RouteDto route)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Session.RestoreAsync();
            if (string.IsNullOrEmpty(Session.AccessToken))
            {
                _error = "Сессия истекла — войдите снова.";
                return;
            }

            await Api.DeleteRouteAsync(route.Id);
            _routes.RemoveAll(r => r.Id == route.Id);
            Toasts.Success("Маршрут удалён");
        }
        catch (SessionExpiredException)
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Error(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private string PlateFor(Guid vehicleId)
    {
        var van = _vehicles.FirstOrDefault(v => v.Id == vehicleId);
        return van is null ? "без автолавки" : van.PlateNumber;
    }
}
