@page "/routes"
@rendermode InteractiveServer
@inject AvtomagazinClient Api
@inject StaffSession Session
@inject NavigationManager Nav

<PageTitle>Маршруты</PageTitle>

<h1>Маршруты и остановки</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert">@_error</div>
}

<section class="panel">
    <h2>Новый маршрут</h2>
    <div class="form-grid">
        <input @bind="_routeName" placeholder="Название маршрута" />
        <select @bind="_routeVehicleId">
            <option value="@Guid.Empty">— автолавка —</option>
            @foreach (var v in _vehicles)
            {
                <option value="@v.Id">@v.PlateNumber · @v.OperatorName</option>
            }
        </select>
        <button class="btn" @onclick="CreateRouteAsync">Создать</button>
    </div>
</section>

@if (_loading)
{
    <p>Загрузка…</p>
}
else
{
    @foreach (var route in _routes)
    {
        <section class="panel">
            <h2>@route.Name</h2>
            <p class="muted">@PlateFor(route.VehicleId)</p>
            <table class="table">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Пункт</th>
                    <th>Регион</th>
                    <th>План UTC</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var s in route.Stops.OrderBy(x => x.Sequence))
                {
                    <tr>
                        <td>@s.Sequence</td>
                        <td>@s.SettlementName</td>
                        <td>@s.RegionCode</td>
                        <td>@s.PlannedArrivalUtc.ToString("dd.MM HH:mm")</td>
                        <td>
                            <button class="btn btn-ghost" @onclick="() => DelayAsync(route.Id, s)">+30 мин</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            <h3>Добавить остановку</h3>
            <div class="form-grid">
                <input type="number" @bind="_stopSeq" placeholder="Порядок" />
                <input @bind="_stopName" placeholder="Деревня" />
                <input @bind="_stopRegion" placeholder="Регион (BY-HR)" />
                <input type="number" step="0.0001" @bind="_stopLat" placeholder="Lat" />
                <input type="number" step="0.0001" @bind="_stopLon" placeholder="Lon" />
                <button class="btn" @onclick="() => AddStopAsync(route.Id)">Добавить</button>
            </div>
        </section>
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<RouteDto> _routes = [];
    private List<VehicleDto> _vehicles = [];
    private string _routeName = "";
    private Guid _routeVehicleId;
    private int _stopSeq = 1;
    private string _stopName = "";
    private string _stopRegion = "BY-HR";
    private double _stopLat = 53.5;
    private double _stopLon = 24.0;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/");
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _vehicles = await Api.GetVehiclesAsync();
            _routes = await Api.GetRoutesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateRouteAsync()
    {
        if (_routeVehicleId == Guid.Empty || string.IsNullOrWhiteSpace(_routeName))
        {
            _error = "Укажи название и автолавку";
            return;
        }

        try
        {
            await Api.CreateRouteAsync(new CreateRouteRequest(_routeName, _routeVehicleId));
            _routeName = "";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task AddStopAsync(Guid routeId)
    {
        try
        {
            await Api.AddStopAsync(routeId, new CreateStopRequest(
                _stopSeq,
                _stopName,
                _stopRegion,
                _stopLat,
                _stopLon,
                DateTimeOffset.UtcNow.AddHours(2)));
            _stopName = "";
            _stopSeq++;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DelayAsync(Guid routeId, RouteStopDto stop)
    {
        try
        {
            await Api.ChangeScheduleAsync(new ChangeScheduleRequest(
                routeId,
                stop.Id,
                stop.PlannedArrivalUtc.AddMinutes(30),
                "Задержка диспетчера (+30 мин)"));
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string PlateFor(Guid vehicleId)
    {
        var van = _vehicles.FirstOrDefault(v => v.Id == vehicleId);
        return van is null ? "автолавка не назначена" : $"{van.PlateNumber} · {van.OperatorName}";
    }
}
