@page "/routes/new"
@page "/routes/{RouteId:guid}"
@inject AvtomagazinClient Api
@inject StaffSession Session
@inject NavigationManager Nav
@inject UiToasts Toasts
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>@(IsNew ? "Новый маршрут" : "Редактор маршрута")</PageTitle>

<StaffPageGate OnReady="BootstrapAsync">
<div class="page-head page-head-sticky">
    <div>
        <div class="brand">@(IsNew ? "Новый маршрут" : "Редактор")</div>
        <div class="who">Точки на карте + время прибытия по каждой остановке.</div>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-ghost" href="routes">К списку</a>
        @if (!IsNew)
        {
            <button type="button" class="btn btn-ghost" disabled="@_busy" @onclick="ReloadAsync">Сбросить</button>
            <button type="button" class="btn btn-ghost btn-danger-text" disabled="@_busy" @onclick="DeleteAsync">Удалить</button>
        }
        <button type="button" class="btn" disabled="@_busy" @onclick="SaveAsync">@(IsNew ? "Создать маршрут" : "Сохранить")</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert visually-hidden" role="alert">@_error</div>
}

<section class="panel route-editor-meta">
    <div class="route-editor-fields">
        <label class="field">
            <span>Название</span>
            <input @bind="_name" placeholder="Например: Минск — Борисов" />
        </label>
        <label class="field">
            <span>Автолавка</span>
            <div class="select-wrap">
                <select @bind="_vehicleId">
                    <option value="@Guid.Empty">Выберите автолавку</option>
                    @foreach (var v in _vehicles)
                    {
                        <option value="@v.Id">@v.PlateNumber · @v.OperatorName</option>
                    }
                </select>
            </div>
        </label>
    </div>
</section>

<div class="map map-route" id="route-editor-map"></div>
<p class="tiny muted">Клик — новая точка, перетащите номер чтобы сдвинуть. Ниже задайте план прибытия (расписание рейса).</p>

<RouteEditStops Stops="_stops"
                Rename="args => RenameStop(args.Index, args.Name)"
                MoveUp="MoveUp"
                MoveDown="MoveDown"
                Remove="RemoveStop"
                PlanChanged="args => SetPlanLocal(args.Index, args.Value)"
                ClearPhoto="ClearStopPhoto"
                PhotoSelected="args => OnStopPhotoSelected(args.Index, args.Args)" />
</StaffPageGate>
