@page "/fleet"
@inject AvtomagazinClient Api
@inject StaffSession Session
@inject NavigationManager Nav

<PageTitle>Автопарк</PageTitle>

<div class="page-head">
    <div>
        <div class="brand">Автопарк</div>
        <div class="who">Список автолавок. Создание и правки — на отдельных экранах.</div>
    </div>
    <a class="btn" href="fleet/new">Новая автолавка</a>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert">@_error</div>
}

@if (_loading)
{
    <p class="muted">Загрузка…</p>
}
else if (_vehicles.Count == 0)
{
    <p class="empty">Автолавок пока нет. Добавьте первую.</p>
}
else
{
    <ul class="feed">
        @foreach (var v in _vehicles.OrderBy(x => x.PlateNumber))
        {
            <li class="feed-row fleet-row">
                <div class="fleet-main">
                    @if (!string.IsNullOrEmpty(v.PhotoDataUrl))
                    {
                        <img class="fleet-thumb" src="@v.PhotoDataUrl" alt="" />
                    }
                    else
                    {
                        <div class="fleet-thumb fleet-thumb-empty" aria-hidden="true"></div>
                    }
                    <div>
                        <strong>@v.PlateNumber</strong>
                        <span class="feed-sub">
                            @v.OperatorName · @(v.IsActive ? "активна" : "выкл")
                            @if (!string.IsNullOrWhiteSpace(v.DriverName))
                            {
                                <text> · вод. @v.DriverName</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(v.SellerName))
                            {
                                <text> · прод. @v.SellerName</text>
                            }
                        </span>
                    </div>
                </div>
                <div class="feed-side">
                    <a class="btn btn-ghost" href="@($"fleet/{v.Id}")">Открыть</a>
                </div>
            </li>
        }
    </ul>
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<VehicleDto> _vehicles = [];

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/");
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _vehicles = await Api.GetVehiclesAsync();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
