@page "/fleet"
@inject AvtomagazinClient Api
@inject StaffSession Session
@inject NavigationManager Nav

<PageTitle>Автопарк</PageTitle>

<h1>Автопарк</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert">@_error</div>
}

<section class="panel">
    <h2>Добавить автолавку</h2>
    <div class="form-grid">
        <input @bind="_plate" placeholder="Госномер" />
        <input @bind="_operator" placeholder="Оператор (райпо)" />
        <button type="button" class="btn" @onclick="CreateAsync">Создать</button>
    </div>
</section>

@if (_loading)
{
    <p>Загрузка…</p>
}
else
{
    @foreach (var v in _vehicles)
    {
        <section class="panel">
            <div class="list-row" style="border:0;padding-top:0">
                <div>
                    <strong>@v.PlateNumber</strong>
                    <div class="muted">@v.OperatorName · @(v.IsActive ? "активна" : "выкл")</div>
                </div>
                <button class="btn btn-ghost" @onclick="() => ToggleAsync(v)">
                    @(v.IsActive ? "Выключить" : "Включить")
                </button>
            </div>

            <div class="form-grid" style="margin-top:0.75rem">
                <input value="@Edit(v).DriverName" @onchange="e => Edit(v).DriverName = e.Value?.ToString()" placeholder="Водитель" />
                <input value="@Edit(v).DriverPhone" @onchange="e => Edit(v).DriverPhone = e.Value?.ToString()" placeholder="Тел. водителя" />
                <input value="@Edit(v).SellerName" @onchange="e => Edit(v).SellerName = e.Value?.ToString()" placeholder="Продавец" />
                <input value="@Edit(v).SellerPhone" @onchange="e => Edit(v).SellerPhone = e.Value?.ToString()" placeholder="Тел. продавца" />
                <input value="@Edit(v).OperatorPhone" @onchange="e => Edit(v).OperatorPhone = e.Value?.ToString()" placeholder="Тел. райпо" />
                <button type="button" class="btn" @onclick="() => SaveContactsAsync(v)">Сохранить контакты</button>
            </div>
        </section>
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<VehicleDto> _vehicles = [];
    private readonly Dictionary<Guid, ContactEdit> _edits = new();
    private string _plate = "";
    private string _operator = "";

    private sealed class ContactEdit
    {
        public string? DriverName { get; set; }
        public string? DriverPhone { get; set; }
        public string? SellerName { get; set; }
        public string? SellerPhone { get; set; }
        public string? OperatorPhone { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/");
            return;
        }

        await ReloadAsync();
    }

    private ContactEdit Edit(VehicleDto v)
    {
        if (!_edits.TryGetValue(v.Id, out var edit))
        {
            edit = new ContactEdit
            {
                DriverName = v.DriverName,
                DriverPhone = v.DriverPhone,
                SellerName = v.SellerName,
                SellerPhone = v.SellerPhone,
                OperatorPhone = v.OperatorPhone
            };
            _edits[v.Id] = edit;
        }

        return edit;
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _vehicles = await Api.GetVehiclesAsync();
            _edits.Clear();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        try
        {
            await Api.CreateVehicleAsync(new CreateVehicleRequest(_plate, _operator));
            _plate = "";
            _operator = "";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ToggleAsync(VehicleDto v)
    {
        try
        {
            await Api.SetVehicleActiveAsync(v.Id, !v.IsActive);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SaveContactsAsync(VehicleDto v)
    {
        var edit = Edit(v);
        try
        {
            await Api.UpdateVehicleContactsAsync(v.Id, new UpdateVehicleContactsRequest(
                edit.DriverName,
                edit.DriverPhone,
                edit.SellerName,
                edit.SellerPhone,
                edit.OperatorPhone));
            _error = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
