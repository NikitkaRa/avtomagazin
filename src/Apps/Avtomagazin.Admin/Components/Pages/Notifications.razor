@page "/notifications"
@inject AvtomagazinClient Api
@inject StaffSession Session
@inject NavigationManager Nav

<PageTitle>Уведомления</PageTitle>

<h1>Подписки жителей</h1>
<p class="lead">Сколько человек держат пункт в избранном — там есть кому слать пуш и куда есть смысл ехать.</p>

<table class="table">
    <thead>
    <tr>
        <th>Пункт</th>
        <th>Подписчиков</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var s in _stats)
    {
        <tr>
            <td>@s.SettlementName</td>
            <td>@s.SubscriberCount</td>
        </tr>
    }
    </tbody>
</table>

<h1>Лог пушей</h1>

<div class="form-grid">
    <input @bind="_settlement" placeholder="Деревня" />
    <button class="btn" @onclick="ReloadAsync">Обновить</button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert">@_error</div>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Когда</th>
            <th>Пункт</th>
            <th>Заголовок</th>
            <th>Текст</th>
            <th>Получателей</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var n in _items)
        {
            <tr>
                <td>@n.SentAtUtc.ToLocalTime().ToString("dd.MM HH:mm:ss")</td>
                <td>@n.SettlementName</td>
                <td>@n.Title</td>
                <td>@n.Body</td>
                <td>@n.RecipientCount</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private string? _error;
    private string _settlement = "";
    private List<NotificationDto> _items = [];
    private List<FavoriteStatsDto> _stats = [];

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/");
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _items = await Api.GetNotificationsAsync(string.IsNullOrWhiteSpace(_settlement) ? null : _settlement);
            _stats = await Api.GetFavoriteStatsAsync();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
