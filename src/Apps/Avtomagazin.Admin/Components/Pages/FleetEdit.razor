@page "/fleet/new"
@page "/fleet/{VehicleId:guid}"
@inject AvtomagazinClient Api
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Новая автолавка" : "Автолавка")</PageTitle>

<StaffPageGate OnReady="BootstrapAsync">
<div class="page-head">
    <div>
        <div class="brand">@(IsNew ? "Новая автолавка" : _plate)</div>
        <div class="who">Госномер уникален. Водитель и продавец — из списка сотрудников.</div>
    </div>
    <a class="btn btn-ghost" href="fleet">К списку</a>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert">@_error</div>
}
@if (!string.IsNullOrEmpty(_ok))
{
    <div class="panel ok">@_ok</div>
}

@if (_loading)
{
    <p class="muted">Загрузка…</p>
}
else
{
    <section class="panel">
        <div class="form-grid">
            <label class="field">
                <span>Госномер</span>
                <input @bind="_plate" placeholder="1234 AB-7" />
            </label>
            <label class="field">
                <span>Оператор (райпо)</span>
                <input @bind="_operator" placeholder="Название райпо" />
            </label>
            <label class="field">
                <span>Тел. райпо</span>
                <input @bind="_operatorPhone" placeholder="+375…" />
            </label>
            <label class="field">
                <span>Статус</span>
                <select @bind="_isActiveText">
                    <option value="true">Активна</option>
                    <option value="false">Выключена</option>
                </select>
            </label>
        </div>
    </section>

    <section class="block">
        <header class="block-head">
            <h2>Люди</h2>
        </header>
        <div class="route-editor-fields">
            <label class="field">
                <span>Водитель</span>
                <div class="select-wrap">
                    <select @bind="_driverUserId" @bind:after="OnDriverPicked">
                        <option value="@Guid.Empty">Не назначен</option>
                        @foreach (var p in Drivers)
                        {
                            <option value="@p.Id">@p.DisplayName · @p.RoleTitle</option>
                        }
                    </select>
                </div>
            </label>
            <label class="field">
                <span>Продавец</span>
                <div class="select-wrap">
                    <select @bind="_sellerUserId" @bind:after="OnSellerPicked">
                        <option value="@Guid.Empty">Не назначен</option>
                        @foreach (var p in Sellers)
                        {
                            <option value="@p.Id">@p.DisplayName · @p.RoleTitle</option>
                        }
                    </select>
                </div>
            </label>
        </div>
    </section>

    <PhotoField Url="@_photoDataUrl" Alt="Автолавка" Selected="OnPhotoSelected" Cleared="ClearPhoto" />

    <div class="row" style="margin: 1rem 0 1.5rem;">
        <button type="button" class="btn" disabled="@_busy" @onclick="SaveAsync">@(IsNew ? "Создать" : "Сохранить")</button>
    </div>
}
</StaffPageGate>
