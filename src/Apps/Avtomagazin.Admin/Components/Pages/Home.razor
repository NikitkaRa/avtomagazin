@page "/"
@inject StaffSession Session
@implements IDisposable

@if (!Session.IsAuthenticated)
{
    <LoginPanel />
}
else
{
    <div class="page-head">
        <div>
            <div class="brand">Автомагазин</div>
            <div class="who">@(Session.IsDriver ? "Водитель" : Session.IsAdmin ? "Админ" : "Диспетчер") · @Session.Name</div>
        </div>
        <button type="button" class="btn btn-ghost" @onclick="Session.SignOut">Выйти</button>
    </div>
    @if (Session.IsDriver)
    {
        <DrivePanel />
    }
    else
    {
        <DispatchPanel />
    }
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.RestoreAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Session.Changed -= OnChanged;
}
