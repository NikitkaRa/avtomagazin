@inherits LayoutComponentBase
@inject StaffSession Session
@inject NavigationManager Nav
@implements IDisposable

<div class="app @(Session.IsAuthenticated ? "app-in" : "app-out")">
    @if (Session.IsAuthenticated && !IsHome)
    {
        <header class="topbar">
            <div>
                <div class="brand">Автомагазин</div>
                <div class="who">@Session.Name · @(Session.IsDriver ? "водитель" : Session.IsAdmin ? "админ" : "диспетчер")</div>
            </div>
            <button type="button" class="btn btn-ghost" @onclick="Session.SignOut">Выйти</button>
        </header>
    }
    <main class="main">
        @Body
    </main>
    @if (Session.IsAuthenticated)
    {
        <nav class="tabbar">
            @if (Session.IsDriver)
            {
                <NavLink href="/" Match="NavLinkMatch.All">Рейс</NavLink>
            }
            else
            {
                <NavLink href="/" Match="NavLinkMatch.All">Карта</NavLink>
                <NavLink href="routes">Маршруты</NavLink>
                <NavLink href="fleet">Парк</NavLink>
                <NavLink href="coverage">Визиты</NavLink>
                <NavLink href="notifications">Пуши</NavLink>
                @if (Session.IsAdmin)
                {
                    <NavLink href="users">Люди</NavLink>
                }
            }
        </nav>
    }
</div>

@code {
    private bool IsHome
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            return path.Length == 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        await Session.RestoreAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Session.RestoreAsync();
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
