@inherits LayoutComponentBase
@inject StaffSession Session
@inject NavigationManager Nav
@inject UiToasts Toasts
@implements IDisposable

<div class="app @(_ready && Session.IsAuthenticated ? "app-in" : "app-out")">
    @if (!_ready)
    {
        <p class="muted" style="padding: 2rem 1.25rem;">Загрузка…</p>
    }
    else if (Session.IsAuthenticated)
    {
        <aside class="sidenav" aria-label="Разделы">
            <div class="sidenav-head">
                <span class="sidenav-mark" aria-hidden="true"></span>
                <div>
                    <div class="brand">Автомагазин</div>
                    <div class="sidenav-sub">Персонал</div>
                </div>
            </div>

            <nav class="sidenav-nav">
                @if (Session.IsVanCrew)
                {
                    <NavLink href="/" Match="NavLinkMatch.All">Рейс</NavLink>
                }
                else
                {
                    <NavLink href="/" Match="NavLinkMatch.All">Мониторинг</NavLink>
                    <NavLink href="map">Карта</NavLink>
                    <NavLink href="routes">Маршруты</NavLink>
                    <NavLink href="fleet">Парк</NavLink>
                    <NavLink href="favorites">Подписки</NavLink>
                    @if (Session.IsAdmin)
                    {
                        <NavLink href="users">Люди</NavLink>
                    }
                }
            </nav>

            <div class="sidenav-foot">
                <div class="sidenav-user">
                    <span class="sidenav-role">@RoleLabel</span>
                    <NavLink href="profile" class="sidenav-name" title="Профиль">@Session.Name</NavLink>
                </div>
                <button type="button" class="sidenav-exit" @onclick="Session.SignOut">Выйти</button>
            </div>
        </aside>

        <div class="workspace">
            <header class="topbar">
                <div class="topbar-left">
                    <span class="topbar-mark" aria-hidden="true"></span>
                    <div class="topbar-copy">
                        <div class="brand">Автомагазин</div>
                        <div class="who">
                            <span class="topbar-role">@RoleLabel</span>
                            <span class="topbar-sep" aria-hidden="true">·</span>
                            <NavLink href="profile" class="topbar-name" title="Профиль">@Session.Name</NavLink>
                        </div>
                    </div>
                </div>
                <button type="button" class="topbar-exit" @onclick="Session.SignOut">Выйти</button>
            </header>

            <main class="main">
                @Body
            </main>

            <nav class="tabbar" aria-label="Разделы">
                @if (Session.IsVanCrew)
                {
                    <NavLink href="/" Match="NavLinkMatch.All">Рейс</NavLink>
                    <NavLink href="profile">Профиль</NavLink>
                }
                else
                {
                    <NavLink href="/" Match="NavLinkMatch.All">Мониторинг</NavLink>
                    <NavLink href="map">Карта</NavLink>
                    <NavLink href="routes">Маршруты</NavLink>
                    <NavLink href="fleet">Парк</NavLink>
                    <NavLink href="favorites">Подписки</NavLink>
                    @if (Session.IsAdmin)
                    {
                        <NavLink href="users">Люди</NavLink>
                    }
                    <NavLink href="profile">Профиль</NavLink>
                }
            </nav>
        </div>
    }
    else
    {
        @Body
    }

    <ToastHost />
</div>

@code {
    private bool _ready;
    private bool _wasAuthenticated;

    private string RoleLabel => Session.Role switch
    {
        "driver" => "Водитель",
        "seller" => "Продавец",
        "admin" => "Админ",
        _ => "Диспетчер"
    };

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _ready)
        {
            return;
        }

        await Session.RestoreAsync();
        _ready = Session.IsRestored;
        _wasAuthenticated = Session.IsAuthenticated;
        await InvokeAsync(StateHasChanged);
    }

    private void OnChanged()
    {
        var authed = Session.IsAuthenticated;
        if (_ready && _wasAuthenticated && !authed)
        {
            if (Session.LastSignOutReason == SignOutReason.Expired)
            {
                Toasts.Error("Сессия истекла — войдите снова.");
            }

            Nav.NavigateTo("/", forceLoad: false);
        }

        _wasAuthenticated = authed;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
