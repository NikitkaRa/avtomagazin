@inject AvtomagazinClient Api
@inject UiToasts Toasts
@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="dispatch">
    <div class="page-head" style="padding-top:0">
        <div>
            <div class="brand">Мониторинг</div>
            <div class="who">Жалобы, сообщения водителей и ход рейсов.</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="alert">@_loadError</div>
    }

    <DispatchPulse Attention="@(_cases.Sum(c => c.ReportCount) + _notes.Count)"
                   Live="@_liveCount"
                   Routes="@ActiveRoutes.Count()"
                   Warn="@(_cases.Count > 0 || _notes.Count > 0)" />

    <DispatchAttention Notes="FilteredNotes"
                       Cases="FilteredCases"
                       StatusFilter="@_statusFilter"
                       SettlementQuery="@_settlementQuery"
                       StatusFilterChanged="SetStatusFilterAsync"
                       SettlementQueryChanged="q => _settlementQuery = q"
                       OpenTrip="OpenTripAsync"
                       OpenCase="OpenAttentionCaseAsync"
                       VanOf="VanOf"
                       RouteOf="RouteOf" />

    <DispatchActiveRoutes Rows="ActiveRoutes" OpenTrip="OpenTripAsync" />
</div>

@if (_tripVehicleId is Guid tripId)
{
    var tripVan = VanOf(tripId);
    var tripRoute = RouteOf(tripId);
    var tripNote = NoteOf(tripId);
    var tripStops = (tripRoute?.Stops ?? []).OrderBy(s => s.Sequence).ToList();
    var tripCases = _cases.Where(c => c.VehicleId == tripId)
        .OrderByDescending(c => c.Status != CaseStatuses.Closed)
        .ThenByDescending(c => c.UpdatedAtUtc)
        .ToList();
    <DispatchTripSheet Van="tripVan"
                       Route="tripRoute"
                       Note="tripNote"
                       Cases="tripCases"
                       History="DispatchBoard.TripHistory(tripId, tripStops, tripNote, _cases)"
                       Close="CloseTripAsync"
                       OpenCase="OpenCaseAsync" />
}

@if (_detail is not null)
{
    <DispatchCaseSheet Detail="_detail"
                       Van="VanOf(_detail.VehicleId)"
                       Comment="@_comment"
                       CommentChanged="v => _comment = v"
                       Error="@_caseError"
                       Busy="_busy"
                       Close="CloseCase"
                       AddComment="AddCommentAsync"
                       MarkInProgress="MarkInProgressAsync"
                       CloseStatus="CloseCaseStatusAsync"
                       Reopen="ReopenCaseAsync" />
}
