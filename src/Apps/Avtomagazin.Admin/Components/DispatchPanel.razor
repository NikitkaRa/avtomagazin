@inject AvtomagazinClient Api
@inject StaffSession Session
@inject IJSRuntime Js
@using Microsoft.JSInterop
@implements IAsyncDisposable

<div class="dispatch">
    <div class="page-head" style="padding-top:0">
        <div>
            <div class="brand">Мониторинг</div>
            <div class="who">Жалобы и ход рейсов: где отстаём от графика.</div>
        </div>
    </div>

    <div class="pulse">
        <div class="pulse-item @(_cases.Count > 0 ? "pulse-warn" : null)">
            <span class="pulse-n">@_cases.Sum(c => c.ReportCount)</span>
            <span class="pulse-l">жалобы</span>
        </div>
        <div class="pulse-item @(_delayedCount > 0 ? "pulse-warn" : null)">
            <span class="pulse-n">@_delayedCount</span>
            <span class="pulse-l">с отставанием</span>
        </div>
    </div>

    <section class="block">
        <header class="block-head">
            <h2>Внимание</h2>
            <span class="block-meta">@FilteredCases.Count()</span>
        </header>
        <div class="attn-tools">
            <div class="filter-chips" role="tablist" aria-label="Статус">
                <button type="button" class="chip @(_statusFilter == "active" ? "chip-on" : null)" @onclick='() => SetStatusFilterAsync("active")'>Активные</button>
                <button type="button" class="chip @(_statusFilter == "open" ? "chip-on" : null)" @onclick='() => SetStatusFilterAsync("open")'>Открыты</button>
                <button type="button" class="chip @(_statusFilter == "in_progress" ? "chip-on" : null)" @onclick='() => SetStatusFilterAsync("in_progress")'>В процессе</button>
                <button type="button" class="chip @(_statusFilter == "closed" ? "chip-on" : null)" @onclick='() => SetStatusFilterAsync("closed")'>Закрыты</button>
                <button type="button" class="chip @(_statusFilter == "all" ? "chip-on" : null)" @onclick='() => SetStatusFilterAsync("all")'>Все</button>
            </div>
            <input class="attn-search" @bind="_settlementQuery" @bind:event="oninput" placeholder="Поиск по населённому пункту" />
        </div>
        @if (!FilteredCases.Any())
        {
            <p class="empty">@(string.IsNullOrWhiteSpace(_settlementQuery) ? "Нет кейсов по этому фильтру." : "Ничего не найдено.")</p>
        }
        else
        {
            <ul class="feed">
                @foreach (var item in FilteredCases)
                {
                    var van = VanOf(item.VehicleId);
                    <li class="feed-row @(item.Status == "closed" ? null : "warn") feed-action" @onclick="() => OpenCaseAsync(item.Id)">
                        <div>
                            <strong>@item.SettlementName</strong>
                            <span class="feed-sub">
                                @People(item.ReportCount) · @StatusLabel(item.Status)
                                @if (van is not null)
                                {
                                    <text> · @van.PlateNumber</text>
                                }
                            </span>
                        </div>
                        <div class="feed-side">
                            <span class="eta-min">@item.ReportCount</span>
                            <time>@Ago(item.UpdatedAtUtc)</time>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="block">
        <header class="block-head">
            <h2>Активные маршруты</h2>
            <span class="block-meta">@ActiveRoutes.Count()</span>
        </header>
        @if (!ActiveRoutes.Any())
        {
            <p class="empty">Нет активных рейсов — автолавка на маршруте должна быть в парке и на связи.</p>
        }
        else
        {
            <ul class="feed">
                @foreach (var row in ActiveRoutes)
                {
                    <li class="feed-row @(row.IsLate ? "route-late" : null)">
                        <div class="route-line">
                            @if (row.HasGps)
                            {
                                <span class="gps-pill @(row.Live ? "gps-live" : "gps-stale")"
                                      title="@(row.Live ? "Эфир GPS" : "Последний GPS")">GPS</span>
                            }
                            <div>
                                <strong>@row.RouteName</strong>
                                <span class="feed-sub">
                                    @row.Plate
                                    @if (!string.IsNullOrEmpty(row.NextStop))
                                    {
                                        <text> · след. @row.NextStop</text>
                                    }
                                </span>
                            </div>
                        </div>
                        <div class="feed-side">
                            <span class="@(row.IsLate ? "route-late-badge" : null)">@row.DelayLabel</span>
                            @if (!string.IsNullOrEmpty(row.ScheduleLabel))
                            {
                                <time>@row.ScheduleLabel</time>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@if (_detail is not null)
{
    <div class="case-modal" @onclick="CloseCase">
        <div class="case-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <header class="case-sheet-head">
                <div>
                    <div class="eyebrow">Инцидент</div>
                    <h2>@_detail.SettlementName</h2>
                    <p class="muted">@StatusLabel(_detail.Status) · @People(_detail.ReportCount)</p>
                </div>
                <button type="button" class="btn btn-ghost" @onclick="CloseCase">Закрыть</button>
            </header>
            <div class="case-dialog-scroll">
        @{
            var caseVan = VanOf(_detail.VehicleId);
        }
        @if (caseVan is not null)
        {
            <section class="case-block">
                <h3>Автолавка</h3>
                <p class="case-plate">@caseVan.PlateNumber · @caseVan.OperatorName</p>
                <ul class="contact-list">
                    @if (!string.IsNullOrWhiteSpace(caseVan.DriverPhone))
                    {
                        <li>
                            <span>Водитель @(caseVan.DriverName ?? "")</span>
                            <a href="tel:@Digits(caseVan.DriverPhone)">@caseVan.DriverPhone</a>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(caseVan.SellerPhone))
                    {
                        <li>
                            <span>Продавец @(caseVan.SellerName ?? "")</span>
                            <a href="tel:@Digits(caseVan.SellerPhone)">@caseVan.SellerPhone</a>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(caseVan.OperatorPhone))
                    {
                        <li>
                            <span>Райпо</span>
                            <a href="tel:@Digits(caseVan.OperatorPhone)">@caseVan.OperatorPhone</a>
                        </li>
                    }
                    @if (string.IsNullOrWhiteSpace(caseVan.DriverPhone)
                         && string.IsNullOrWhiteSpace(caseVan.SellerPhone)
                         && string.IsNullOrWhiteSpace(caseVan.OperatorPhone))
                    {
                        <li class="muted">Контактов нет — добавьте во вкладке «Парк».</li>
                    }
                </ul>
            </section>
        }
        else
        {
            <section class="case-block">
                <p class="muted">Автолавка по маршруту не найдена.</p>
            </section>
        }

        <section class="case-block">
            <h3>Действия</h3>
            <label class="case-field">
                <span>Комментарий</span>
                <textarea @bind="_comment" rows="2" placeholder="Что сделали / что ждём"></textarea>
            </label>
            <div class="row">
                <button type="button" class="btn" disabled="@(_busy || string.IsNullOrWhiteSpace(_comment))" @onclick="AddCommentAsync">Коммент</button>
                <button type="button" class="btn @(_detail.Status == "in_progress" ? "" : "btn-ghost")" disabled="@_busy"
                        @onclick="MarkInProgressAsync">В процессе</button>
                <button type="button" class="btn btn-ghost" disabled="@_busy"
                        @onclick="CloseCaseStatusAsync">Закрыть кейс</button>
                @if (_detail.Status == "closed")
                {
                    <button type="button" class="btn btn-ghost" disabled="@_busy"
                            @onclick="ReopenCaseAsync">Снова открыть</button>
                }
            </div>
        </section>

        <section class="case-block">
            <h3>История</h3>
            @if (_detail.Events.Count == 0)
            {
                <p class="muted">Пока пусто.</p>
            }
            else
            {
                <ul class="timeline">
                    @foreach (var ev in _detail.Events.OrderByDescending(e => e.CreatedAtUtc))
                    {
                        <li>
                            <div class="timeline-top">
                                <strong>@EventKind(ev)</strong>
                                <time>@ev.CreatedAtUtc.ToLocalTime().ToString("dd.MM HH:mm")</time>
                            </div>
                            <p>@ev.Body</p>
                            @if (!string.IsNullOrWhiteSpace(ev.StopLabel))
                            {
                                <p class="tiny muted">@ev.StopLabel</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(ev.AuthorName) || !string.IsNullOrWhiteSpace(ev.AuthorEmail))
                            {
                                <p class="tiny muted">@(ev.AuthorName ?? ev.AuthorEmail)</p>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        @if (!string.IsNullOrEmpty(_caseError))
        {
            <div class="alert">@_caseError</div>
        }
            </div>
        </div>
    </div>
}

@code {
    private List<VehicleDto> _vans = [];
    private List<CaseSummaryDto> _cases = [];
    private List<EtaDto> _etas = [];
    private List<RouteDto> _routes = [];
    private CaseDetailDto? _detail;
    private string _comment = "";
    private string _statusFilter = "active";
    private string _settlementQuery = "";
    private string? _caseError;
    private bool _busy;
    private CancellationTokenSource? _poll;

    private int _delayedCount => ActiveRoutes.Count(r => r.IsLate);

    private IEnumerable<CaseSummaryDto> FilteredCases
    {
        get
        {
            IEnumerable<CaseSummaryDto> items = _cases;
            if (!string.IsNullOrWhiteSpace(_settlementQuery))
            {
                var q = _settlementQuery.Trim();
                items = items.Where(c =>
                    c.SettlementName.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || c.SettlementKey.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            return items
                .OrderByDescending(c => c.Status != "closed")
                .ThenByDescending(c => c.ReportCount)
                .ThenByDescending(c => c.UpdatedAtUtc);
        }
    }

    private IEnumerable<RouteProgress> ActiveRoutes
    {
        get
        {
            var etaByRoute = _etas
                .GroupBy(e => e.RouteId)
                .ToDictionary(g => g.Key, g => g.OrderBy(e => e.EstimatedArrivalUtc).First());

            var rows = new List<RouteProgress>();
            foreach (var route in _routes)
            {
                var van = VanOf(route.VehicleId);
                if (van is null || !van.IsActive)
                {
                    continue;
                }

                if (!IsLive(van) && van.LastLatitude is null && !etaByRoute.ContainsKey(route.Id))
                {
                    continue;
                }

                var stops = (route.Stops ?? []).OrderBy(s => s.Sequence).ToList();
                if (stops.Count == 0)
                {
                    continue;
                }

                etaByRoute.TryGetValue(route.Id, out var eta);
                RouteStopDto? next = null;
                if (eta is not null)
                {
                    next = stops.FirstOrDefault(s => s.Id == eta.StopId)
                           ?? stops.FirstOrDefault(s =>
                               s.SettlementName.Equals(eta.SettlementName, StringComparison.OrdinalIgnoreCase));
                }

                next ??= stops
                    .Where(s => s.PlannedArrivalUtc >= DateTimeOffset.UtcNow.AddMinutes(-30))
                    .OrderBy(s => s.PlannedArrivalUtc)
                    .FirstOrDefault()
                    ?? stops.Last();

                int? delay = null;
                string delayLabel;
                string scheduleLabel;
                if (eta is not null && next is not null)
                {
                    delay = (int)Math.Round((eta.EstimatedArrivalUtc - next.PlannedArrivalUtc).TotalMinutes);
                    delayLabel = delay switch
                    {
                        > 2 => $"+{delay} мин",
                        < -2 => $"{delay} мин",
                        _ => "по графику"
                    };
                    scheduleLabel =
                        $"план {next.PlannedArrivalUtc.ToLocalTime():HH:mm} · ETA {eta.EstimatedArrivalUtc.ToLocalTime():HH:mm}";
                }
                else if (next is not null)
                {
                    delayLabel = IsLive(van) ? "ждём ETA" : "нет ETA";
                    scheduleLabel = $"план {next.PlannedArrivalUtc.ToLocalTime():HH:mm}";
                }
                else
                {
                    delayLabel = "—";
                    scheduleLabel = "";
                }

                rows.Add(new RouteProgress(
                    route.Name,
                    van.PlateNumber,
                    next?.SettlementName ?? "",
                    delay,
                    delayLabel,
                    scheduleLabel,
                    IsLive(van),
                    van.LastLatitude is not null));
            }

            return rows
                .OrderByDescending(r => r.IsLate)
                .ThenByDescending(r => r.DelayMinutes ?? int.MinValue)
                .ThenByDescending(r => r.Live)
                .ThenByDescending(r => r.HasGps)
                .ThenBy(r => r.RouteName);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _poll = new CancellationTokenSource();
        _ = LoopAsync(_poll.Token);
    }

    private async Task LoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await ReloadAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
            }

            await Task.Delay(6000, ct);
        }
    }

    private async Task ReloadAsync()
    {
        var status = _statusFilter switch
        {
            "active" => "open,in_progress",
            "all" => "open,in_progress,closed",
            _ => _statusFilter
        };

        try
        {
            var snap = await Api.GetDispatchSnapshotAsync(status);
            _vans = snap.Vehicles;
            _cases = snap.Cases;
            _etas = snap.Eta;
            _routes = snap.Routes;
        }
        catch
        {
            try
            {
                _vans = await Api.GetVehiclesAsync();
            }
            catch
            {
            }
        }
    }

    private async Task SetStatusFilterAsync(string filter)
    {
        if (_statusFilter == filter)
        {
            return;
        }

        _statusFilter = filter;
        await ReloadAsync();
    }

    private async Task OpenCaseAsync(Guid id)
    {
        _caseError = null;
        _comment = "";
        try
        {
            _detail = await Api.GetCaseAsync(id);
            await SetBodyLockAsync(true);
        }
        catch (Exception ex)
        {
            _caseError = ex.Message;
        }
    }

    private async Task CloseCase()
    {
        _detail = null;
        _caseError = null;
        await SetBodyLockAsync(false);
    }

    private async Task SetBodyLockAsync(bool locked)
    {
        try
        {
            await Js.InvokeVoidAsync(
                "eval",
                locked
                    ? "document.documentElement.classList.add('case-open');document.body.classList.add('case-open');"
                    : "document.documentElement.classList.remove('case-open');document.body.classList.remove('case-open');");
        }
        catch
        {
        }
    }

    private async Task AddCommentAsync()
    {
        if (_detail is null || string.IsNullOrWhiteSpace(_comment))
        {
            return;
        }

        _busy = true;
        _caseError = null;
        try
        {
            _detail = await Api.AddCaseCommentAsync(_detail.Id, _comment.Trim());
            _comment = "";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _caseError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task MarkInProgressAsync() => SetStatusAsync("in_progress");
    private Task CloseCaseStatusAsync() => SetStatusAsync("closed");
    private Task ReopenCaseAsync() => SetStatusAsync("open");

    private async Task SetStatusAsync(string status)
    {
        if (_detail is null)
        {
            return;
        }

        _busy = true;
        _caseError = null;
        try
        {
            var note = string.IsNullOrWhiteSpace(_comment) ? null : _comment.Trim();
            _detail = await Api.SetCaseStatusAsync(_detail.Id, status, note);
            _comment = "";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _caseError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private VehicleDto? VanOf(Guid? vehicleId)
        => vehicleId is Guid id ? _vans.FirstOrDefault(v => v.Id == id) : null;

    private static bool IsLive(VehicleDto van)
        => string.Equals(van.LastSource, "driver-app", StringComparison.OrdinalIgnoreCase);

    private static string StatusLabel(string status) => status switch
    {
        "open" => "открыта",
        "in_progress" => "в процессе",
        "closed" => "закрыта",
        _ => status
    };

    private static string EventKind(CaseEventDto ev) => ev.Kind switch
    {
        "report" => "Жалоба",
        "status" => "Статус",
        "comment" => "Комментарий",
        _ => ev.Kind
    };

    private static string People(int count) => count switch
    {
        1 => "1 человек",
        >= 2 and <= 4 => $"{count} человека",
        _ => $"{count} человек"
    };

    private static string Digits(string phone)
        => new string(phone.Where(c => char.IsDigit(c) || c == '+').ToArray());

    private static string Ago(DateTimeOffset when)
    {
        var delta = DateTimeOffset.UtcNow - when.ToUniversalTime();
        if (delta.TotalSeconds < 60)
        {
            return "сейчас";
        }

        if (delta.TotalMinutes < 60)
        {
            return $"{(int)delta.TotalMinutes} мин";
        }

        if (delta.TotalHours < 24)
        {
            return $"{(int)delta.TotalHours} ч";
        }

        return when.ToLocalTime().ToString("dd.MM HH:mm");
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await SetBodyLockAsync(false);
        }
        catch (JSDisconnectedException)
        {
        }

        _poll?.Cancel();
        _poll?.Dispose();
    }

    private sealed record RouteProgress(
        string RouteName,
        string Plate,
        string NextStop,
        int? DelayMinutes,
        string DelayLabel,
        string ScheduleLabel,
        bool Live,
        bool HasGps)
    {
        public bool IsLate => DelayMinutes is > 2;
    }
}
