@inject AvtomagazinClient Api
@inject StaffSession Session
@inject IJSRuntime Js
@using Microsoft.JSInterop
@implements IAsyncDisposable

<section class="sheet drive-sheet">
    <div class="drive-body">
        @if (_tab == "route")
        {
            <div class="drive-head">
                <h2>@(_vehicle?.PlateNumber ?? "Нет автолавки")</h2>
                <p class="muted">@RouteSubtitle</p>
            </div>

            <div class="eta-card">
                <div class="eta-kicker">Следующая</div>
                <div class="eta-title">@(_trip.NextTitle)</div>
                <div class="eta-time">@_trip.NextMeta</div>
                @if (_trip.Next is not null)
                {
                    <div class="row drive-next-actions">
                        <button class="btn" disabled="@_arriving" @onclick="() => CompleteNextAsync(false)">На месте</button>
                        <button class="btn btn-ghost" disabled="@_arriving" @onclick="() => CompleteNextAsync(true)">Пропустить</button>
                    </div>
                }
            </div>

            @if (_trip.Rows.Count > 0)
            {
                <p class="muted drive-stops-label">Остановки сегодня</p>
                <div class="stack drive-stops">
                    @foreach (var row in _trip.Rows)
                    {
                        <div class="list-row drive-stop-row @(row.IsNext ? "is-next" : null) @(row.Done ? "is-done" : null)">
                            <div>
                                <strong>@row.Stop.Sequence. @row.Stop.SettlementName</strong>
                                @if (!string.IsNullOrEmpty(row.Status))
                                {
                                    <div class="muted">@row.Status</div>
                                }
                            </div>
                            <time class="drive-stop-time">@row.Time</time>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_status))
            {
                <p class="alert">@_status</p>
            }
        }
        else
        {
            <h2>Трансляция позиции</h2>
            <p class="muted">Диспетчер видит вашу точку на карте, пока GPS включён.</p>
            <p class="@(_live ? "ok" : "muted")">@(_gpsStatus)</p>
            <div class="row">
                <button class="btn" disabled="@_live" @onclick="StartLiveAsync">Включить GPS</button>
                <button class="btn btn-ghost" disabled="@(!_live)" @onclick="StopAsync">Выключить</button>
            </div>
            @if (!string.IsNullOrEmpty(_status))
            {
                <p class="alert">@_status</p>
            }
        }
    </div>

    <nav class="drive-tabbar" role="tablist">
        <button type="button" class="drive-tab @(_tab == "route" ? "is-on" : null)" @onclick='() => _tab = "route"'>Рейс</button>
        <button type="button" class="drive-tab @(_tab == "gps" ? "is-on" : null)" @onclick='() => _tab = "gps"'>GPS</button>
    </nav>
</section>

@code {
    private string _tab = "route";
    private VehicleDto? _vehicle;
    private RouteDto? _route;
    private DriveItinerary _trip = DriveItinerary.FromStops([]);
    private string _gpsStatus = "GPS выключен";
    private string? _status;
    private bool _live;
    private bool _arriving;
    private int _watchId;
    private IJSObjectReference? _geo;
    private DotNetObjectReference<DrivePanel>? _self;
    private CancellationTokenSource? _poll;
    private double? _lat;
    private double? _lng;

    private string RouteSubtitle => DriveItinerary.Subtitle(_vehicle, _route);

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _poll = new CancellationTokenSource();
        _ = LoopAsync(_poll.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        try
        {
            _geo = await Js.InvokeAsync<IJSObjectReference>("import", "./js/geo.js");
        }
        catch (Exception ex)
        {
            _status = ApiErrors.Friendly(ex);
        }
    }

    private async Task ReloadAsync()
    {
        var snap = await Api.GetSnapshotAsync();
        var id = Session.VehicleId;
        _vehicle = id is Guid vid
            ? snap.Vehicles.FirstOrDefault(v => v.Id == vid)
            : null;
        _route = _vehicle is null ? null : RouteDto.ForVehicle(snap.Routes, _vehicle.Id);
        _trip = DriveItinerary.FromStops(_route?.Stops);
    }

    private async Task LoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await ReloadAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                _status = ApiErrors.Friendly(ex);
            }

            await Task.Delay(8000, ct);
        }
    }

    private async Task CompleteNextAsync(bool skipped)
    {
        if (_vehicle is null || _trip.Next is null)
        {
            return;
        }

        _arriving = true;
        try
        {
            await Api.ArriveAtStopAsync(_trip.Next.Id, _vehicle.Id, skipped, _lat, _lng);
            _status = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _status = ApiErrors.Friendly(ex);
        }
        finally
        {
            _arriving = false;
        }
    }

    private async Task StartLiveAsync()
    {
        if (_geo is null || _self is null)
        {
            _status = "Геолокация недоступна в этом браузере";
            return;
        }

        _watchId = await _geo.InvokeAsync<int>("startWatch", _self);
        _live = true;
        _gpsStatus = "Ждём точку…";
        _status = null;
    }

    private async Task StopAsync()
    {
        if (_geo is not null && _watchId != 0)
        {
            await _geo.InvokeVoidAsync("stop", _watchId);
        }

        _live = false;
        _watchId = 0;
        _gpsStatus = "GPS выключен";
    }

    [JSInvokable]
    public async Task OnGeo(double lat, double lng, double? speedKmh, double? accuracyM = null)
    {
        if (_vehicle is null)
        {
            return;
        }

        try
        {
            await Api.IngestPositionAsync(_vehicle.Id, lat, lng, speedKmh);
            _lat = lat;
            _lng = lng;
            _gpsStatus = $"В эфире · {BelarusTime.ToMinsk(DateTimeOffset.UtcNow):HH:mm:ss}";
            _status = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _status = ApiErrors.Friendly(ex);
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnGeoError(string message)
    {
        _status = ApiErrors.Friendly(message);
        _gpsStatus = "GPS ошибка";
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _poll?.Cancel();
        _poll?.Dispose();
        if (_geo is not null && _watchId != 0)
        {
            try
            {
                await _geo.InvokeVoidAsync("stop", _watchId);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }
}
