@inject AvtomagazinClient Api
@inject StaffSession Session
@inject IJSRuntime Js
@using Microsoft.JSInterop
@implements IAsyncDisposable

<section class="sheet drive-sheet">
    <div class="drive-body">
        @if (_tab == "route")
        {
            <div class="drive-head">
                <h2>@(_vehicle?.PlateNumber ?? "Нет автолавки")</h2>
                <p class="muted">@RouteSubtitle</p>
            </div>

            <div class="eta-card">
                <div class="eta-kicker">Следующая</div>
                <div class="eta-title">@(_nextTitle)</div>
                <div class="eta-time">@_nextMeta</div>
                @if (_next is not null)
                {
                    <div class="row drive-next-actions">
                        <button class="btn" disabled="@_arriving" @onclick="() => CompleteNextAsync(false)">На месте</button>
                        <button class="btn btn-ghost" disabled="@_arriving" @onclick="() => CompleteNextAsync(true)">Пропустить</button>
                    </div>
                }
            </div>

            @if (_rows.Count > 0)
            {
                <p class="muted drive-stops-label">Остановки сегодня</p>
                <div class="stack drive-stops">
                    @foreach (var row in _rows)
                    {
                        <div class="list-row drive-stop-row @(row.IsNext ? "is-next" : null) @(row.Done ? "is-done" : null)">
                            <div>
                                <strong>@row.Stop.Sequence. @row.Stop.SettlementName</strong>
                                @if (!string.IsNullOrEmpty(row.Status))
                                {
                                    <div class="muted">@row.Status</div>
                                }
                            </div>
                            <time class="drive-stop-time">@row.Time</time>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_status))
            {
                <p class="alert">@_status</p>
            }
        }
        else
        {
            <h2>Трансляция позиции</h2>
            <p class="muted">Диспетчер видит вашу точку на карте, пока GPS включён.</p>
            <p class="@(_live ? "ok" : "muted")">@(_gpsStatus)</p>
            <div class="row">
                <button class="btn" disabled="@_live" @onclick="StartLiveAsync">Включить GPS</button>
                <button class="btn btn-ghost" disabled="@(!_live)" @onclick="StopAsync">Выключить</button>
            </div>
            @if (!string.IsNullOrEmpty(_status))
            {
                <p class="alert">@_status</p>
            }
        }
    </div>

    <nav class="drive-tabbar" role="tablist">
        <button type="button" class="drive-tab @(_tab == "route" ? "is-on" : null)" @onclick='() => _tab = "route"'>Рейс</button>
        <button type="button" class="drive-tab @(_tab == "gps" ? "is-on" : null)" @onclick='() => _tab = "gps"'>GPS</button>
    </nav>
</section>

@code {
    private string _tab = "route";
    private VehicleDto? _vehicle;
    private RouteDto? _route;
    private RouteStopDto? _next;
    private List<StopRow> _rows = [];
    private string _nextTitle = "…";
    private string _nextMeta = "";
    private string _gpsStatus = "GPS выключен";
    private string? _status;
    private bool _live;
    private bool _arriving;
    private int _watchId;
    private IJSObjectReference? _geo;
    private DotNetObjectReference<DrivePanel>? _self;
    private CancellationTokenSource? _poll;

    private string RouteSubtitle
    {
        get
        {
            if (_vehicle is null)
            {
                return "Назначьте автолавку в админке";
            }

            var op = _vehicle.OperatorName;
            return _route is null ? op : $"{op} · {_route.Name}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _poll = new CancellationTokenSource();
        _ = LoopAsync(_poll.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        try
        {
            _geo = await Js.InvokeAsync<IJSObjectReference>("import", "./js/geo.js");
        }
        catch (Exception ex)
        {
            _status = FriendlyError(ex.Message);
        }
    }

    private async Task ReloadAsync()
    {
        var snap = await Api.GetSnapshotAsync();
        var id = Session.VehicleId;
        _vehicle = id is Guid vid
            ? snap.Vehicles.FirstOrDefault(v => v.Id == vid)
            : null;
        _route = _vehicle is null ? null : RouteDto.ForVehicle(snap.Routes, _vehicle.Id);
        var stops = (_route?.Stops ?? []).OrderBy(s => s.Sequence).ToList();
        _next = stops.FirstOrDefault(s => s.ArrivedAtUtc is null);

        if (_next is null)
        {
            _nextTitle = stops.Count == 0 ? "Нет остановок на сегодня" : "Рейс завершён";
            _nextMeta = stops.Count == 0 ? "" : "Все остановки отмечены";
        }
        else
        {
            _nextTitle = _next.SettlementName;
            _nextMeta = _next.PlannedArrivalUtc.ToLocalTime().ToString("HH:mm");
        }

        _rows = stops.Select(stop =>
        {
            var done = stop.ArrivedAtUtc is not null;
            var isNext = !done && _next?.Id == stop.Id;
            var status = stop.Skipped
                ? "пропущена"
                : done
                    ? $"был {stop.ArrivedAtUtc!.Value.ToLocalTime():HH:mm}"
                    : isNext ? "сейчас" : "";
            return new StopRow(
                stop,
                isNext,
                done,
                stop.PlannedArrivalUtc.ToLocalTime().ToString("HH:mm"),
                status);
        }).ToList();
    }

    private async Task LoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await ReloadAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                _status = FriendlyError(ex.Message);
            }

            await Task.Delay(8000, ct);
        }
    }

    private async Task CompleteNextAsync(bool skipped)
    {
        if (_vehicle is null || _next is null)
        {
            return;
        }

        _arriving = true;
        try
        {
            await Api.ArriveAtStopAsync(_next.Id, _vehicle.Id, skipped);
            _status = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _status = FriendlyError(ex.Message);
        }
        finally
        {
            _arriving = false;
        }
    }

    private async Task StartLiveAsync()
    {
        if (_geo is null || _self is null)
        {
            _status = "Геолокация недоступна в этом браузере";
            return;
        }

        _watchId = await _geo.InvokeAsync<int>("startWatch", _self);
        _live = true;
        _gpsStatus = "Ждём точку…";
        _status = null;
    }

    private async Task StopAsync()
    {
        if (_geo is not null && _watchId != 0)
        {
            await _geo.InvokeVoidAsync("stop", _watchId);
        }

        _live = false;
        _watchId = 0;
        _gpsStatus = "GPS выключен";
    }

    [JSInvokable]
    public async Task OnGeo(double lat, double lng, double? speedKmh, double? accuracyM = null)
    {
        if (_vehicle is null)
        {
            return;
        }

        try
        {
            await Api.IngestPositionAsync(_vehicle.Id, lat, lng, speedKmh);
            _gpsStatus = $"В эфире · {DateTime.Now:HH:mm:ss}";
            _status = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _status = FriendlyError(ex.Message);
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnGeoError(string message)
    {
        _status = FriendlyError(message);
        _gpsStatus = "GPS ошибка";
        return InvokeAsync(StateHasChanged);
    }

    private static string FriendlyError(string message)
    {
        if (message.Contains("502", StringComparison.Ordinal) || message.Contains("Bad Gateway", StringComparison.OrdinalIgnoreCase))
        {
            return "Сервер временно недоступен";
        }

        if (message.Contains("401", StringComparison.Ordinal) || message.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase))
        {
            return "Сессия истекла — войдите снова";
        }

        return message.Length > 140 ? message[..140] + "…" : message;
    }

    public async ValueTask DisposeAsync()
    {
        _poll?.Cancel();
        _poll?.Dispose();
        if (_geo is not null && _watchId != 0)
        {
            try
            {
                await _geo.InvokeVoidAsync("stop", _watchId);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }

    private sealed record StopRow(RouteStopDto Stop, bool IsNext, bool Done, string Time, string Status);
}
